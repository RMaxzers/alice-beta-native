# Alice Beta 0.1 — copy to .env (Setup-Alice.ps1 generates it). Never commit .env.

# --- environment ---
ALICE_ENV=beta
ALICE_TIMEZONE=America/Santiago
ALICE_HOST=127.0.0.1
ALICE_PORT=8000
ALICE_METRICS_PORT=9101
ALICE_PUBLIC_ORIGIN=https://your-node.your-tailnet.ts.net:8443

# --- security (Setup generates random values) ---
ALICE_USERNAME=admin
ALICE_PASSWORD=change-me
ALICE_SESSION_SECRET=generate-a-random-64-hex-string
ALICE_LOCAL_ONLY=false
# Optional, explicit local-action scope. When unset, Alice cannot create files.
# ALICE_FILE_ROOT=C:\Users\your-user\Alice
# ALICE_EXECUTOR_NAME=Alice en este PC

# --- ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- cloud (disabled until key + budget exist) ---
ALICE_CLOUD_ENABLED=true
OPENROUTER_API_KEY=
ALICE_BUDGET_PER_REQUEST_USD=0.05
ALICE_BUDGET_DAILY_USD=1.00

# --- future providers (not enabled in beta) ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- web research ---
TAVILY_API_KEY=

# --- persistence / telemetry ---
QDRANT_URL=http://127.0.0.1:6333
PROMETHEUS_URL=http://127.0.0.1:9090
ALICE_GRAFANA_LOCAL_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_VIEWER_PASSWORD=change-me

# --- external Grafana (read-only, DISABLED by default) ---
GRAFANA_EXTERNAL_ENABLED=false
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- optional integrations (DISABLED) ---
HERMES_ENABLED=false
HERMES_API_URL=http://127.0.0.1:8642
DOCKER_ENABLED=false
DOCKER_ALLOWED_CONTAINERS=alice-qdrant,alice-prometheus,alice-grafana
EMAIL_ENABLED=false
NOTEBOOKLM_ENABLED=false
LOKI_ENABLED=false

# Optional: origins allowed to reach local Grafana through Tailscale Serve (see docs/REMOTE-DEMO.md)
# ALICE_GRAFANA_TRUSTED_ORIGINS=
