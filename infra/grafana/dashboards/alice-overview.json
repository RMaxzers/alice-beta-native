  {
   "id": 14,
   "type": "timeseries",
   "title": "Peticiones por ruta (cada $interval)",
   "description": "increase() sobre el contador; sin datos = ninguna petición desde el arranque de la API o API caída.",
   "datasource": {
    "type": "prometheus",
    "uid": "alice-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "alice-prometheus"
     },
     "expr": "sum by (route) (increase(alice_requests_total[$interval]))",
     "legendFormat": "{{route}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "sin datos",
