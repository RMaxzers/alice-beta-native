  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU del host Windows (% del host, todos los núcleos)",
   "description": "Porcentaje del host completo, no de un núcleo. Fuente: windows_cpu_time_total.",
   "datasource": {
    "type": "prometheus",
    "uid": "alice-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "alice-prometheus"
     },
     "expr": "100 * (1 - avg(rate(windows_cpu_time_total{mode=\"idle\"}[$__rate_interval])))",
     "legendFormat": "CPU host Windows %",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "sin datos",
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
